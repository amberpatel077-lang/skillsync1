rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isTeamMember(teamId) {
      return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds;
    }

    // Users & Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email is string;
      allow delete: if isOwner(userId);
    }

    // Teams
    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.id == teamId
        && request.resource.data.leaderId == request.auth.uid
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isSignedIn()
        && (request.auth.uid in resource.data.memberIds || resource.data.leaderId == request.auth.uid);
      allow delete: if isSignedIn() && resource.data.leaderId == request.auth.uid;

      // Sub-collection: Team Chat Messages
      match /messages/{messageId} {
        allow read: if isTeamMember(teamId);
        allow create: if isTeamMember(teamId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0;
        allow update, delete: if false;
      }

      // Sub-collection: Team Tasks
      match /tasks/{taskId} {
        allow read, write: if isTeamMember(teamId);
      }
    }

    // Opportunities
    match /opportunities/{opportunityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.id == opportunityId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0;
      allow update, delete: if isSignedIn()
        && (resource.data.creatorId == request.auth.uid || !('creatorId' in resource.data));
    }

    // Club Applications
    match /club_applications/{applicationId} {
      allow read: if isSignedIn() && (resource.data.applicantId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.applicantId == request.auth.uid
        && request.resource.data.clubName is string
        && request.resource.data.roleApplied is string;
      allow update: if isSignedIn() && resource.data.applicantId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.applicantId == request.auth.uid;
    }

    // Volunteer Registrations
    match /volunteer_registrations/{registrationId} {
      allow read: if isSignedIn() && (resource.data.volunteerId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.volunteerId == request.auth.uid
        && request.resource.data.eventTitle is string;
      allow update: if isSignedIn() && resource.data.volunteerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.volunteerId == request.auth.uid;
    }

    // Team Invitations
    match /invitations/{invitationId} {
      allow read: if isSignedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string;
      allow update: if isSignedIn()
        && (resource.data.recipientId == request.auth.uid || resource.data.senderId == request.auth.uid);
      allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
    }
  }
}
